{
  "name": "moddog",
  "version": "0.1.0",
  "description": "Let the dog sniff it first. Open-source browser extension that checks GitHub repos and release files for malware before you install them.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/chrome": "^0.3.8",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
